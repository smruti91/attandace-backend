[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/smruti91/myApp.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[remote "origin_app"]
	url = https://github.com/smruti91/myAppServer.git
	fetch = +refs/heads/*:refs/remotes/origin_app/*
[branch "main"]
	remote = origin_app
	merge = refs/heads/main
[branch "face"]
	vscode-merge-base = origin_app/main
